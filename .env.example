# QuizSprint 环境变量配置示例
# 复制为 .env 或在 Docker / PM2 / systemd 中注入

HOST=0.0.0.0
PORT=8787
DATA_DIR=./data

# 管理与认证安全（生产部署强烈建议固定配置）
ADMIN_PASSWORD=change-this-strong-password
AUTH_SECRET=replace-with-a-random-32-plus-char-secret
# API_KEY=ak_optional_fixed_external_api_key
# QUESTION_BANK_KEY=optional_userscript_key_for_public_net

# 注册策略（未在后台修改时的初始默认值：open / invite / closed）
REGISTRATION_MODE=open
# REGISTRATION_INVITE_CODE=2026

# 安全与防护选项
# ALLOW_LOCAL_AI=1
# CORS_ORIGIN=https://quiz.example.com
# RATE_LIMIT_MAX=25
# RATE_LIMIT_DISABLED=0

# 运维与自动备份
# AUTO_BACKUP_DISABLED=0
# AUTO_UPDATE_CHECK_MINUTES=3
# DISABLE_SETUP_WIZARD=0
# LOG_ALL=0
