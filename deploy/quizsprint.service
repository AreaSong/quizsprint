[Unit]
Description=QuizSprint 在线题库刷题与考试平台
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/quizsprint
ExecStart=/usr/bin/env node server.mjs
Restart=always
RestartSec=2
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=8787
Environment=AUTH_SECRET=replace-with-random-long-secret

[Install]
WantedBy=multi-user.target
